# Logging
QUANTAGENT_LOG_LEVEL=INFO

# Email notifications (all required except credentials)
QUANTAGENT_SMTP_HOST=smtp.example.com
QUANTAGENT_SMTP_PORT=587
QUANTAGENT_SMTP_TLS=true
QUANTAGENT_EMAIL_FROM=quantagent@example.com
QUANTAGENT_EMAIL_TO=you@example.com

# Set both credentials when the SMTP server requires authentication.
QUANTAGENT_SMTP_USERNAME=
QUANTAGENT_SMTP_PASSWORD=
